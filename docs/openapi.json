{
  "components": {
    "schemas": {
      "AccionPropuesta": {
        "description": "Una accion con efecto secundario que el sistema propone y que NO se ejecuta sin aprobacion humana.",
        "properties": {
          "destinatario": {
            "title": "Destinatario",
            "type": "string"
          },
          "exceso_horas": {
            "minimum": 0.0,
            "title": "Exceso Horas",
            "type": "integer"
          },
          "incidente_id": {
            "title": "Incidente Id",
            "type": "string"
          },
          "motivo": {
            "title": "Motivo",
            "type": "string"
          },
          "severidad": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja"
            ],
            "title": "Severidad",
            "type": "string"
          },
          "tipo": {
            "const": "escalar_incidente",
            "default": "escalar_incidente",
            "title": "Tipo",
            "type": "string"
          }
        },
        "required": [
          "incidente_id",
          "severidad",
          "destinatario",
          "exceso_horas",
          "motivo"
        ],
        "title": "AccionPropuesta",
        "type": "object"
      },
      "AccionesDelJob": {
        "description": "Lo que paso con las acciones criticas: que se propuso, que decidio la persona y que se ejecuto.",
        "properties": {
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionHumana"
              },
              {
                "type": "null"
              }
            ]
          },
          "ejecutadas": {
            "items": {
              "$ref": "#/components/schemas/ResultadoAccion"
            },
            "title": "Ejecutadas",
            "type": "array"
          },
          "propuestas": {
            "items": {
              "$ref": "#/components/schemas/AccionPropuesta"
            },
            "title": "Propuestas",
            "type": "array"
          }
        },
        "title": "AccionesDelJob",
        "type": "object"
      },
      "AprobacionIn": {
        "additionalProperties": false,
        "description": "Cuerpo de POST /tasks/{id}/approve: el mismo contrato que usa el grafo, sin campos de mas y con ejemplo.",
        "example": {
          "aprobada": true,
          "comentario": "Escalar a los responsables.",
          "revisor": "Cris"
        },
        "properties": {
          "aprobada": {
            "title": "Aprobada",
            "type": "boolean"
          },
          "comentario": {
            "default": "",
            "maxLength": 500,
            "title": "Comentario",
            "type": "string"
          },
          "revisor": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Revisor",
            "type": "string"
          }
        },
        "required": [
          "aprobada",
          "revisor"
        ],
        "title": "AprobacionIn",
        "type": "object"
      },
      "AprobacionPendiente": {
        "description": "Lo que ve la persona que tiene que decidir cuando un job queda en WAITING_APPROVAL.",
        "properties": {
          "acciones": {
            "items": {
              "$ref": "#/components/schemas/AccionPropuesta"
            },
            "title": "Acciones",
            "type": "array"
          },
          "informe": {
            "description": "Informe del equipo (recortado) para decidir con contexto.",
            "title": "Informe",
            "type": "string"
          },
          "motivo": {
            "title": "Motivo",
            "type": "string"
          },
          "tipo": {
            "const": "aprobacion_requerida",
            "title": "Tipo",
            "type": "string"
          }
        },
        "required": [
          "tipo",
          "motivo",
          "acciones",
          "informe"
        ],
        "title": "AprobacionPendiente",
        "type": "object"
      },
      "DecisionHumana": {
        "description": "La senal externa que reanuda el grafo: la decision de una persona sobre las acciones propuestas.",
        "properties": {
          "aprobada": {
            "title": "Aprobada",
            "type": "boolean"
          },
          "comentario": {
            "default": "",
            "maxLength": 500,
            "title": "Comentario",
            "type": "string"
          },
          "revisor": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Revisor",
            "type": "string"
          }
        },
        "required": [
          "aprobada",
          "revisor"
        ],
        "title": "DecisionHumana",
        "type": "object"
      },
      "ErrorApi": {
        "description": "Forma de todos los errores que devuelve la API (404, 409, 503...).",
        "properties": {
          "detail": {
            "description": "Que paso y, cuando se puede, que hacer.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorApi",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResultadoAccion": {
        "description": "Que paso con una accion propuesta cuando se la mando a ejecutar.",
        "properties": {
          "destinatario": {
            "title": "Destinatario",
            "type": "string"
          },
          "detalle": {
            "title": "Detalle",
            "type": "string"
          },
          "ejecutada": {
            "title": "Ejecutada",
            "type": "boolean"
          },
          "incidente_id": {
            "title": "Incidente Id",
            "type": "string"
          }
        },
        "required": [
          "incidente_id",
          "destinatario",
          "ejecutada",
          "detalle"
        ],
        "title": "ResultadoAccion",
        "type": "object"
      },
      "ResultadoTarea": {
        "description": "Resultado de un job terminado.",
        "properties": {
          "acciones": {
            "$ref": "#/components/schemas/AccionesDelJob"
          },
          "agentes_que_intervinieron": {
            "items": {
              "type": "string"
            },
            "title": "Agentes Que Intervinieron",
            "type": "array"
          },
          "delegaciones": {
            "default": 0,
            "title": "Delegaciones",
            "type": "integer"
          },
          "estado_final": {
            "anyOf": [
              {
                "enum": [
                  "completado",
                  "limite_de_pasos",
                  "validacion_fallida"
                ],
                "type": "string"
              },
              {
                "const": "desconocido",
                "type": "string"
              }
            ],
            "description": "completado, limite_de_pasos o validacion_fallida (lo decide el supervisor).",
            "title": "Estado Final"
          },
          "fuentes_citadas": {
            "description": "Politicas del RAG que la respuesta cita, con su codigo y fuente (por ejemplo 'GD-POL-001 (01-politica.md, pag. 1)').",
            "items": {
              "type": "string"
            },
            "title": "Fuentes Citadas",
            "type": "array"
          },
          "respuesta": {
            "title": "Respuesta",
            "type": "string"
          }
        },
        "required": [
          "estado_final",
          "respuesta"
        ],
        "title": "ResultadoTarea",
        "type": "object"
      },
      "Salud": {
        "description": "Respuesta de GET /health.",
        "properties": {
          "estado": {
            "const": "ok",
            "title": "Estado",
            "type": "string"
          },
          "redis": {
            "const": "ok",
            "title": "Redis",
            "type": "string"
          },
          "tareas_en_cola": {
            "minimum": 0.0,
            "title": "Tareas En Cola",
            "type": "integer"
          }
        },
        "required": [
          "estado",
          "redis",
          "tareas_en_cola"
        ],
        "title": "Salud",
        "type": "object"
      },
      "TareaCreada": {
        "description": "Respuesta inmediata de POST /tasks: el ticket para consultar el estado.",
        "properties": {
          "consultar_en": {
            "title": "Consultar En",
            "type": "string"
          },
          "estado": {
            "enum": [
              "PENDING",
              "RUNNING",
              "WAITING_APPROVAL",
              "DONE",
              "FAILED"
            ],
            "title": "Estado",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "estado",
          "consultar_en"
        ],
        "title": "TareaCreada",
        "type": "object"
      },
      "TareaEstado": {
        "description": "Respuesta de GET /tasks/{id}: el registro del job en Redis.",
        "properties": {
          "actualizado_en": {
            "title": "Actualizado En",
            "type": "string"
          },
          "aprobacion_pendiente": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AprobacionPendiente"
              },
              {
                "type": "null"
              }
            ]
          },
          "creado_en": {
            "title": "Creado En",
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionHumana"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "estado": {
            "enum": [
              "PENDING",
              "RUNNING",
              "WAITING_APPROVAL",
              "DONE",
              "FAILED"
            ],
            "title": "Estado",
            "type": "string"
          },
          "finalizado_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finalizado En"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "recuperaciones": {
            "default": 0,
            "description": "Veces que otro worker retomo este job desde su checkpoint porque el anterior se cayo.",
            "title": "Recuperaciones",
            "type": "integer"
          },
          "resultado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultadoTarea"
              },
              {
                "type": "null"
              }
            ]
          },
          "segundos_de_ejecucion": {
            "default": 0.0,
            "title": "Segundos De Ejecucion",
            "type": "number"
          },
          "tarea": {
            "title": "Tarea",
            "type": "string"
          },
          "uso": {
            "$ref": "#/components/schemas/UsoDelModelo"
          }
        },
        "required": [
          "job_id",
          "estado",
          "tarea",
          "creado_en",
          "actualizado_en"
        ],
        "title": "TareaEstado",
        "type": "object"
      },
      "TareaIn": {
        "additionalProperties": false,
        "description": "Cuerpo de POST /tasks.",
        "example": {
          "tarea": "Priorizá los incidentes abiertos del maestro de artículos y citá la política que fija sus plazos."
        },
        "properties": {
          "tarea": {
            "description": "Consulta para el equipo de agentes.",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Tarea",
            "type": "string"
          }
        },
        "required": [
          "tarea"
        ],
        "title": "TareaIn",
        "type": "object"
      },
      "UsoDelModelo": {
        "description": "Llamadas y tokens gastados por el job (el costo en dolares lo calcula el dashboard de trazas).",
        "properties": {
          "llamadas_al_modelo": {
            "default": 0,
            "title": "Llamadas Al Modelo",
            "type": "integer"
          },
          "tokens_entrada": {
            "default": 0,
            "title": "Tokens Entrada",
            "type": "integer"
          },
          "tokens_salida": {
            "default": 0,
            "title": "Tokens Salida",
            "type": "integer"
          }
        },
        "title": "UsoDelModelo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nExpone el sistema de inteligencia (supervisor + investigador con RAG, analista y redactor)\ncomo un servicio de produccion: las tareas se encolan en Redis, las corre un worker aparte y las que\ntienen un efecto externo (escalar un incidente critico) se pausan hasta que una persona las apruebe.\nLos datos son ficticios (Mercado Austral S.A.).\n",
    "title": "API de producción: orquestador multi-agente",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "salud_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Redis no responde."
          }
        },
        "summary": "Estado del servicio",
        "tags": [
          "salud"
        ]
      }
    },
    "/tasks": {
      "post": {
        "description": "Registra el job y lo encola; responde de inmediato con el `job_id` para consultar el estado.",
        "operationId": "crear_tarea_tasks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TareaIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TareaCreada"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Redis no responde: la tarea no quedó encolada."
          }
        },
        "summary": "Encolar una tarea",
        "tags": [
          "tareas"
        ]
      }
    },
    "/tasks/{job_id}": {
      "get": {
        "operationId": "estado_de_la_tarea_tasks__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TareaEstado"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "No existe un job con ese ID (o ya expiró)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Redis no responde."
          }
        },
        "summary": "Consultar el estado de una tarea",
        "tags": [
          "tareas"
        ]
      }
    },
    "/tasks/{job_id}/approve": {
      "post": {
        "description": "Entrega la senal externa que reanuda el grafo. No lo corre: registra la decision y encola la reanudacion.",
        "operationId": "aprobar_tarea_tasks__job_id__approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AprobacionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TareaCreada"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "No existe un job con ese ID (o ya expiró)."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "El job no está esperando una decisión, o ya recibió una."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                }
              }
            },
            "description": "Redis no responde; la decisión no quedó registrada, se puede reintentar."
          }
        },
        "summary": "Aprobar o rechazar las acciones críticas de un job pausado",
        "tags": [
          "aprobación humana"
        ]
      }
    }
  }
}

# Copiá este archivo a .env y pegá tus claves (ANTHROPIC_API_KEY, PINECONE_API_KEY y GOOGLE_API_KEY). El .env NO se sube al repositorio.
# `docker compose` también lee este archivo.
ANTHROPIC_API_KEY=pega-aca-tu-clave

# --- Redis (estado de los jobs, cola y checkpoints de LangGraph) ---
# Tiene que ser Redis 8+ o Redis Stack. Con `docker compose up -d redis` queda en esta dirección.
REDIS_URL=redis://localhost:6379

# --- Observabilidad (Arize Phoenix) ---
# OBSERVABILIDAD=true                                             # false para correr sin trazas
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces      # adonde manda las trazas el worker
# PHOENIX_PROJECT_NAME=orquestador-gobierno-de-datos              # proyecto de Phoenix donde aparecen
# VERSION_PROMPTS=final-v1                                        # se anota en cada traza

# --- Worker y retención de datos (valores por defecto entre paréntesis) ---
# WORKER_CONCURRENCIA=5            # cuántos jobs corre a la vez un worker
# JOB_TIMEOUT_SEGUNDOS=300         # tiempo máximo de un job; pasado ese tiempo queda en FAILED
# TTL_JOBS_SEGUNDOS=604800         # cuánto se conserva el registro de un job (7 días)
# TTL_CHECKPOINTS_MINUTOS=10080    # cuánto se conservan los checkpoints (7 días)

# --- Orquestador ---
# MODELO_LLM=claude-haiku-4-5            # modelo para todos los agentes
# MODELO_SUPERVISOR=claude-haiku-4-5     # pisa MODELO_LLM solo para el supervisor
# MODELO_ESPECIALISTAS=claude-haiku-4-5  # pisa MODELO_LLM solo para los especialistas
# MAX_PASOS=10                           # cuántas veces el supervisor puede delegar en una tarea (mínimo 3)
# MAX_INTENTOS_POR_AGENTE=3              # veces que se le puede pedir su trabajo a un mismo agente
# RECURSION_ESPECIALISTA=12              # techo de pasos del ciclo ReAct interno de cada especialista

# --- RAG (Pinecone Starter + embeddings de Gemini: ambos tienen plan gratuito) ---
PINECONE_API_KEY=pega-aca-tu-clave
GOOGLE_API_KEY=pega-aca-tu-clave
INDEX_NAME=rag-gobierno-de-datos        # índice de Pinecone (obligatorio; lo crea `python -m rag.setup_index` si no existe)
# PINECONE_NAMESPACE=mercado-austral    # namespace donde viven los 36 fragmentos
# EMBEDDING_MODEL=gemini-embedding-001  # modelo de embeddings (1536 dimensiones)
